# お問い合わせフォームの設定
# このファイルを .env という名前でコピーし、値を書き換えて使う。
# .env にはパスワードが含まれるため、Git には含めない (.gitignore 済み)。

# ---- サイト設定 ----
SITE_TITLE="QWEL.DESIGN"
# Origin / Referer チェックに使う (末尾のスラッシュなし)
SITE_URL="https://qwel.design"
# 送信元・管理者宛の通知先
ADMIN_EMAIL="webmaster@qwel.design"

# ---- SMTP 設定 ----
SMTP_HOST="smtp.example.com"
SMTP_USER="webmaster@qwel.design"
SMTP_PASS="********"
SMTP_PORT=587
# tls (STARTTLS, 通常は 587 番)、ssl (SMTPS, 通常は 465 番)、none (暗号化なし。ローカルのテスト用のみ)
SMTP_SECURE=tls

# ---- 項目設定 ----
# 必須項目の name 属性 (カンマ区切り)
REQUIRED_FIELDS="お名前,Email,件名,メッセージ本文"
# メールアドレス入力欄の name 属性
EMAIL_FIELD="Email"

# ---- 迷惑メール対策 ----
# ボット対策の見えない入力欄 (ハニーポット) の name 属性 (index.html と合わせる)
HONEYPOT_FIELD="website_url"
# 同じ人 (セッション) が続けて送信できるまでの秒数 (0 で制限しない)
SEND_INTERVAL=60

# ---- 自動返信メールの署名 ----
# ダブルクォートの中は改行をそのまま書ける
MAIL_FOOTER="
後日ご返信致しますので今しばらくお待ちください。

────────────────────────────────────────────────
福井の物作りのためのweb制作&プログラミング教室
QWEL.DESIGN (クヴェル・デザイン)

伊藤 大悟 (代表)
────────────────────────────────────────────────
"
